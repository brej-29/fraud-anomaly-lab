  "narrative": {
    "northStar": "Environmental Wayfinding",
    "overview": "Clearcut treats a capacity decision as a place to navigate with confidence. Warm paper, forest ink, acid-green selection, fine dividers, and humanist letterforms establish a quiet working environment. The chart receives generous space; compact observations and controls keep the decision in view.\n\nThe system is measured and direct. Counts, denominators, source identity, and uncertainty sit beside the result they qualify. Flat surfaces and familiar native controls support inspection; visual emphasis follows the selected state and the analyst's next action.",
    "keyCharacteristics": [
      "Warm paper with forest anchors and a restrained lime selection signal.",
      "Spacious charts paired with compact, precise controls.",
      "Humanist text and tabular figures for comparisons.",
      "Explicit source, outcome, and uncertainty context.",
      "Responsive navigation and independently scrollable data tables."
    ],
    "rules": [
      {
        "name": "The Selection Rule",
        "body": "Lime identifies active location or chosen capacity. Observed fraud capture uses green and retains a numeric label.",
        "section": "colors"
      },
      {
        "name": "The Evidence Rule",
        "body": "Chart series combine color, stroke pattern, and a text legend; exact counts remain available in a table.",
        "section": "colors"
      },
      {
        "name": "The Stable Figures Rule",
        "body": "Tables, outputs, and metric values use tabular numerals so changing capacity does not disturb comparisons.",
        "section": "typography"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Preserve tonal layering and hairline separation for persistent surfaces; reserve floating elevation for transient feedback.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep active selection, observed capture, comparison, and errors semantically distinct.",
      "**Do** align changing figures with tabular numerals and preserve shared denominators.",
      "**Do** retain source, uncertainty, and legitimate-review cost beside the decision.",
      "**Do** preserve visible phone navigation labels and the table overflow hint.",
      "**Do** use inline stroke icons, native range/select behavior, and visible keyboard focus.",
      "**Do** honor reduced motion and provide meaningful empty and validation states."
    ],
    "donts": [
      "**Don't** use color alone to identify a series, selection, or known outcome.",
      "**Don't** add persistent card shadows where tonal layering and fine borders already separate content.",
      "**Don't** shrink table data to fit a phone; preserve legibility and contained scrolling.",
      "**Don't** imply observed capture when labels are absent, or present a synthetic batch as benchmark evidence.",
      "**Don't** hide the legitimate workload or uncertainty behind the headline result."
    ]
  }
}
